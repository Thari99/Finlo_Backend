# Copy this file to .env and fill in your values

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_TIMEOUT_S=60
CLAUDE_MAX_TOKENS=1024

# ── Google Sign-In ───────────────────────────────────────────────────────────
# *Web* OAuth client ID (NOT Android). Same value must be in the Flutter
# app as --dart-define=GOOGLE_WEB_CLIENT_ID=...
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com

# ── Backend session JWT ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-random-jwt-secret-here
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Quotas + cost guardrails ─────────────────────────────────────────────────
# Free tier: 3 AI chats per day, 10 OCR bill scans per day.
FREE_DAILY_LIMIT=3
OCR_FREE_DAILY_LIMIT=10
# Hard input ceiling (chars). ~4 chars/token. Reject any request that exceeds.
MAX_INPUT_CHARS=80000
# Monthly USD ceiling per user. Defense-in-depth above daily message limit.
MONTHLY_USD_CAP=5.0
# Override if Anthropic changes Haiku pricing (USD per million tokens).
INPUT_USD_PER_MTOK=1.0
OUTPUT_USD_PER_MTOK=5.0

# ── Environment ──────────────────────────────────────────────────────────────
# development | production
# Production: /docs is disabled, CORS defaults to deny-all, REDIS_URL required.
ENV=development

# ── Redis ────────────────────────────────────────────────────────────────────
# Required in production (rate limit, refresh tokens, monthly cost, user
# store all live here). Optional in dev — services fall back to in-memory.
# Example: redis://default:password@redis-host:6379/0
REDIS_URL=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins for browser callers. Empty in production = deny.
# Example: https://app.finlo.com,https://staging.finlo.com
CORS_ORIGINS=

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN. Leave blank to disable.
SENTRY_DSN=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
